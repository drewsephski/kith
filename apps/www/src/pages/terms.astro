---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout
  title="Terms · Kith"
  description="Service and open-source information for Kith."
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Terms of Service</h1>
      <p>Kith is open-source software. The service operator is responsible for its policies, data handling, and any commercial terms. For questions about your account or the service, visit <a href="/support/">Support</a>.</p>
      <p>Read the <a href="/privacy/">privacy policy</a> to understand how information is processed and the choices available to you. The <a href="https://github.com/drewsephski/kith/blob/main/LICENSE">Apache-2.0 license</a> covers the source code; it does not set the terms of the hosted service.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
