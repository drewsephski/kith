---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout
  title="Terms · Kith"
  description="Service operator and open-source terms for Kith."
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Terms of Service</h1>
      <p>Kith is open-source software. The operator of the service you use is responsible for its policies, data handling, and any commercial terms. Contact that operator before sharing private information.</p>
      <p>The fork does not claim to operate the upstream Rakazo service. Its <a href="https://rakazo.com/terms/" rel="noreferrer" target="_blank">upstream terms policy</a> describes that service and does not establish policies for a separate Kith deployment.</p>
      <p>Self-hosting and service configuration are described in the <a href="https://github.com/drewsephski/kith/blob/main/docs/hosted-deployment.md">deployment guide</a>.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
