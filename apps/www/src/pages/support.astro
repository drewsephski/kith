---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SUPPORT_EMAIL } from "../site";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout title="Support · Kith" description="Get help with your account, connected apps, and conversations.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Kith support</h1>
      <p>
        Get help with sign-in, your account, connected services, or the Kith app.
      </p>
      {SUPPORT_EMAIL && <p>Email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> for private support or privacy requests. Include your app version and a short description of the problem. Never send passwords, API keys, or access tokens.</p>}
      <h2>Sign-in and connections</h2>
      <p>Use <strong>Forgot password?</strong> on the sign-in screen to reset your password. You can disconnect services in the app and revoke access in the connected service's settings.</p>
      <h2>Account deletion</h2>
      <p>
        Open <strong>Account</strong> in the mobile app, choose <strong>Delete account</strong>,
        complete the requested identity check, and confirm. This deletes your account and its personal
        Space data. Content shared with other members and records held by connected services may remain.
      </p>
      {SUPPORT_EMAIL && <p>If you cannot sign in, email <a href={`mailto:${SUPPORT_EMAIL}?subject=Kith%20account%20deletion`}>{SUPPORT_EMAIL}</a> from your account's email address. We will verify your request before deleting account data.</p>}
      <h2>Software issues</h2>
      <p>Report reproducible bugs in the <a href={`${GITHUB_URL}/issues`}>issue tracker</a>. Keep account information and private screenshots out of public reports. Read our <a href="/privacy/">privacy policy</a> for data handling and privacy choices.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
