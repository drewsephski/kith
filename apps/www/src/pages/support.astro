---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout title="Support · Kith" description="Get help with the Kith app and self-hosted Kith.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Kith support</h1>
      <p>
        For account help, contact the operator of the Kith service you signed in to.
        For reproducible software issues, use the <a href={`${GITHUB_URL}/issues`}>issue tracker</a>.
        Do not include private account information, passwords, API keys, or access tokens in public issues.
      </p>
      <h2>Self-hosted Kith</h2>
      <p>
        Start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>. For reproducible bugs or feature requests,
        open an issue in the <a href={`${GITHUB_URL}/issues`}>Kith GitHub repository</a>.
      </p>
      <h2>Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
