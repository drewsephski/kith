---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import { getJourneyCopy } from "../i18n/journey";
import Header from "./Header.astro";
import { ProductDemo } from "./ProductDemo";

import { getHomeCopy } from "../i18n/home";
import type { Locale } from "../i18n/locales";
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
} from "../i18n/locales";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeStructuredData } from "../structured-data";
import {
  GITHUB_URL,
  SELF_HOST_GUIDE_PATH,
  webStartHref,
  SITE_URL,
} from "../site";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;

const copy = getHomeCopy(locale);
const journey = getJourneyCopy(locale);
const WEB_START_URL = webStartHref(locale);
const DESKTOP_URL = locale === "en" ? "/download/" : `/${locale}/download/`;
const enCopy = getHomeCopy(DEFAULT_LOCALE);
const availableLanguages = LOCALES.map((supportedLocale) =>
  getHomeCopy(supportedLocale).availableLanguage
);
const homeHref = localeHomePath(locale);
const stars = await fetchGithubStars();
const starsLabel = stars === null ? copy.starFallback : formatStarCount(stars);
const pageUrl = `${SITE_URL}${homeHref === "/" ? "/" : homeHref}`;

const structuredData = homeStructuredData({
  pageUrl,
  title: copy.title,
  description: journey.lead,
  siteDescription: enCopy.description,
  inLanguage: LOCALE_HTML_LANG[locale],
  defaultInLanguage: LOCALE_HTML_LANG[DEFAULT_LOCALE],
  availableLanguages,
  faq: journey.faq,
});
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} starsLabel={starsLabel} homeHref={homeHref} />

    <main id="main" class="consumer-home">
      <section class="hero journey-hero" id="get-started">
        <img class="journey-companion" src="/brand/kith-companion.webp" width="96" height="96" alt="" fetchpriority="high" />
        <h1>{journey.heading.split("\n").map((line) => <span>{line}</span>)}</h1>
        <p class="lead">{journey.lead}</p>
        <div class="hero__actions">
          <Button href={WEB_START_URL}>{journey.web}</Button>
          <Button href={DESKTOP_URL} variant="secondary">{journey.desktop}</Button>
        </div>
      </section>

      <section id="demo" aria-label={copy.nav.product}>
        <p class="journey-demo-label">{journey.demo}</p>
        <ProductDemo locale={locale} client:visible />
      </section>

      <section id="product" class="section journey-benefits" aria-label={copy.nav.product}>
        {journey.benefits.map((benefit) => (
          <article><h2>{benefit.title}</h2><p>{benefit.body}</p></article>
        ))}
      </section>

      <section id="how-it-works" class="section journey-how">
        <h2 class="section-heading">{journey.how}</h2>
        <ol>{journey.steps.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
      </section>

      <section id="selfhost" class="section journey-open">
        <div><h2 class="section-heading">{journey.openTitle}</h2><p class="section-copy">{journey.openBody}</p></div>
        <div class="selfhost-cta">
          <Button href={SELF_HOST_GUIDE_PATH} variant="secondary">{copy.openSource.readTheDocs}</Button>
          <Button href={GITHUB_URL} variant="secondary" external>{copy.hero.viewOnGithub}</Button>
        </div>
      </section>

      <section id="faq" class="section journey-faq-section" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="section-heading">{copy.faq.heading}</h2>
        <div class="journey-faq">{journey.faq.map((item) => (
          <details data-faq-item>
            <summary>{item.question}<svg class="journey-faq__indicator" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg></summary>
            <div class="journey-faq__answer"><p>{item.answer}</p></div>
          </details>
        ))}</div>
      </section>

      <section class="section journey-close">
        <h2 class="section-heading">{journey.close}</h2>
        <div class="hero__actions">
          <Button href={WEB_START_URL}>{journey.web}</Button>
          <Button href={DESKTOP_URL} variant="secondary">{journey.desktop}</Button>
        </div>
      </section>
    </main>

    <Footer
      locale={locale}
      languagesLabel={copy.footer.languagesLabel}
      navLabel={copy.footer.navLabel}
      homeLabel={copy.nav.home}
      linkLabels={copy.footer.links}
      homeHref={homeHref}
    />
  </div>
</BaseLayout>

<script>
  import { enhanceFaq } from "../faq";
  enhanceFaq();
</script>
