---
import type { HomeCopy } from "../i18n/home";
import { getJourneyCopy } from "../i18n/journey";
import { DEFAULT_LOCALE, isLocale } from "../i18n/locales";
import { DESKTOP_URL, WEB_START_URL } from "../site";
import Button from "./Button.astro";

type Props = { copy: HomeCopy["getStartedDialog"]; waitlist: HomeCopy["waitlist"] };
const { copy } = Astro.props;
const journey = getJourneyCopy(isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);
---
<dialog class="get-started-dialog" data-get-started-dialog aria-labelledby="get-started-title">
  <div class="get-started-dialog__panel">
    <button class="get-started-dialog__close" type="button" data-get-started-close aria-label={copy.closeLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
    </button>
    <h2 id="get-started-title">{journey.start}</h2>
    <div class="get-started-dialog__actions">
      <Button href={WEB_START_URL}>{journey.web}</Button>
      <Button href={DESKTOP_URL} variant="secondary">{journey.desktop}</Button>
    </div>
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-get-started-dialog]");
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !dialog) return;
    if (event.target.closest("[data-get-started-open]")) dialog.showModal();
    if (event.target.closest("[data-get-started-close]") || event.target === dialog) dialog.close();
  });
</script>
