---
import { getHomeCopy } from "../i18n/home";
import type { HomeCopy } from "../i18n/home";
import type { Locale } from "../i18n/locales";
import {
  DEFAULT_LOCALE,
  localeHashPath,
  localeHomePath,
} from "../i18n/locales";
import { getJourneyCopy } from "../i18n/journey";

import { GITHUB_URL, SELF_HOST_GUIDE_PATH, webStartHref, signInHref } from "../site";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

type Props = {
  starsLabel: string;
  locale?: Locale;
  copy?: HomeCopy["nav"];
  homeHref?: string;
};

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const copy = Astro.props.copy ?? getHomeCopy(locale).nav;
const homeHref = Astro.props.homeHref ?? localeHomePath(locale);

const journey = getJourneyCopy(locale);
const startHref = webStartHref(locale);

const NAV_LINKS: Array<{ href: string; label: string; external?: boolean }> = [
  { href: localeHashPath(locale, "product"), label: copy.product },
  { href: localeHashPath(locale, "how-it-works"), label: journey.how },
  { href: GITHUB_URL, label: "GitHub", external: true },
];
const menuLinks = [...NAV_LINKS, { href: SELF_HOST_GUIDE_PATH, label: copy.selfHost }];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  return (href.replace(/\/+$/, "") || "/") === currentPath;
}

const externalAttrs = { target: "_blank", rel: "noreferrer" };
---

<header class="site-header">
  <div class="site-header__left">
    <Logo href={homeHref} label={copy.home} />
    <nav class="site-nav" aria-label={copy.primary}>
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={!link.external && isCurrent(link.href) ? "page" : undefined}
            {...(link.external ? externalAttrs : {})}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="site-header__right">
    <a class="journey-sign-in" href={signInHref(locale)}>{journey.signIn}</a>
    <div class="site-header__cta">
      <Button href={startHref} size="sm">{journey.start}</Button>
    </div>
    <details class="site-menu" data-site-menu>
      <summary class="site-menu__toggle" aria-label={copy.menu}>
        <svg class="site-menu__icon site-menu__icon--open" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" />
        </svg>
        <svg class="site-menu__icon site-menu__icon--close" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </summary>
      <nav class="site-menu__panel" aria-label={copy.primary}>
        {
          menuLinks.map((link) => (
            <a
              href={link.href}
              aria-current={!link.external && isCurrent(link.href) ? "page" : undefined}
              {...(link.external ? externalAttrs : {})}
            >
              {link.label}
            </a>
          ))
        }
        <Button href={startHref}>{journey.start}</Button>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
  if (menu) {
    const trigger = menu.querySelector<HTMLElement>("summary");
    const close = (restoreFocus = false) => {
      menu.open = false;
      if (restoreFocus) trigger?.focus();
    };
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) close();
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) close(true);
    });
    menu.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (menu.open && !menu.contains(document.activeElement)) close();
      });
    });
    const desktop = matchMedia("(min-width: 960px)");
    desktop.addEventListener("change", () => { if (desktop.matches) close(); });
  }
</script>
