---
import type { FaqItem } from "../alternatives";
import FaqAccordion from "./FaqAccordion.astro";

type Props = { items: readonly FaqItem[]; headingId?: string };
const { items, headingId = "faq" } = Astro.props;
---

<section aria-labelledby={headingId}>
  <h2 id={headingId}>FAQ</h2>
  <FaqAccordion items={items} />
</section>
