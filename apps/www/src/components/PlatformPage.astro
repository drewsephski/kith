---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Button from "./Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getJourneyCopy } from "../i18n/journey";
import { getHomeCopy } from "../i18n/home";
import type { Locale } from "../i18n/locales";
import { APP_URL, DESKTOP_DOWNLOADS, GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";
type Props = { locale?: Locale; platform: "web" | "desktop" };
const { locale = "en", platform } = Astro.props;
const copy = getJourneyCopy(locale);
const webHref = APP_URL ? `${APP_URL}/start` : locale === "en" ? "/start/" : `/${locale}/start/`;
const desktopHref = locale === "en" ? "/download/" : `/${locale}/download/`;
const platforms = [{ name: "macOS", url: DESKTOP_DOWNLOADS.mac }, { name: "Windows", url: DESKTOP_DOWNLOADS.windows }, { name: "Linux", url: DESKTOP_DOWNLOADS.linux }];
---
<BaseLayout title={`${platform === "desktop" ? copy.downloadTitle : copy.webUnavailable} · Kith`} description={platform === "desktop" ? copy.downloadBody : copy.webUnavailableBody} locale={locale} index={platform === "desktop"}>
  <div class="container"><Header starsLabel="" locale={locale} />
    <main id="main" class="platform-page">
      <h1>{platform === "desktop" ? copy.downloadTitle : copy.webUnavailable}</h1>
      <p>{platform === "desktop" ? copy.downloadBody : copy.webUnavailableBody}</p>
      {platform === "desktop" && <div class="platform-list">
        {platforms.map((item) => <article><div><h2>{item.name}</h2>{!item.url && <p>{copy.unavailable}</p>}</div>{item.url && <Button href={item.url}>{copy.install} · {item.name}</Button>}</article>)}
      </div>}
      <div class="hero__actions">
        {platform === "desktop" ? <>
          <Button href={`${GITHUB_URL}/releases`} external>{copy.releases}</Button>
          <Button href={`${GITHUB_URL}/blob/main/docs/desktop-release.md#build-from-source`} variant="secondary" external>{copy.source}</Button>
          <Button href={webHref} variant="secondary">{copy.web}</Button>
        </> : <>
          <Button href={desktopHref}>{copy.desktop}</Button>
          <Button href={SELF_HOST_GUIDE_PATH} variant="secondary">{getHomeCopy(locale).nav.selfHost}</Button>
        </>}
      </div>
    </main><Footer locale={locale} />
  </div>
</BaseLayout>
