---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Button from "./Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getJourneyCopy } from "../i18n/journey";
import type { Locale } from "../i18n/locales";
import { webStartHref, DESKTOP_DOWNLOADS, GITHUB_URL } from "../site";
type Props = { locale?: Locale };
const { locale = "en" } = Astro.props;
const copy = getJourneyCopy(locale);
const webHref = webStartHref(locale);
const platforms = [{ name: "macOS", url: DESKTOP_DOWNLOADS.mac }, { name: "Windows", url: DESKTOP_DOWNLOADS.windows }, { name: "Linux", url: DESKTOP_DOWNLOADS.linux }];
const hasInstallers = platforms.some((item) => item.url);
---
<BaseLayout title={`${copy.downloadTitle} · Kith`} description={copy.downloadBody} locale={locale}>
  <div class="container"><Header starsLabel="" locale={locale} />
    <main id="main" class="platform-page">
      <h1>{copy.downloadTitle}</h1>
      <p>{copy.downloadBody}</p>
      {hasInstallers && <div class="platform-list">
        {platforms.map((item) => <article class:list={{ "platform-unavailable": !item.url }}><div><h2>{item.name}</h2>{!item.url && <p>{copy.unavailable}</p>}</div>{item.url && <Button href={item.url}>{copy.install} · {item.name}</Button>}</article>)}
      </div>}
      {!hasInstallers && <p class="platform-availability">{copy.noInstallers}</p>}
      <div class="hero__actions">
        <Button href={`${GITHUB_URL}/releases`} variant="secondary" external>{copy.releases}</Button>
        <Button href={webHref}>{copy.web}</Button>
      </div>
    </main><Footer locale={locale} />
  </div>
</BaseLayout>
